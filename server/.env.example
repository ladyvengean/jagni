PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# SMTP (port 587 = STARTTLS, so SMTP_SECURE=false. Port 465 = SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Inbox that receives enquiries
CONTACT_TO_EMAIL=
# Must be the authorized sending account (usually same as SMTP_USER)
MAIL_FROM_EMAIL=